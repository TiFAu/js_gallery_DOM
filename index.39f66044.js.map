"use strict";
var nav = document.querySelector(".gallery__list");
var largeImg = document.querySelector("#largeImg");
// eslint-disable-next-line no-shadow
nav.addEventListener("click", function(event) {
    event.preventDefault();
    var link = event.target.closest(".list-item__link");
    if (link && link.getAttribute("href")) largeImg.src = "http://localhost:3001".concat(link.getAttribute("href"));
// console.log(event, event.currentTarget.tagName, event.target.tagName);
// console.log(link, link.getAttribute('href'));
// console.log(largeImg.src);
});

